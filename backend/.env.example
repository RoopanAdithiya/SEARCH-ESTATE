# ==============================================================================
# Search Estate Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Database Connection URL
#
# Option 1: Local SQLite (Default fallback if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./app.db
#
# Option 2: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/searchestate
#
# Option 3: Amazon RDS PostgreSQL (Use in Cloud Deployment)
# DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require

DATABASE_URL=sqlite:///./app.db

# Cloud / Local Machine Learning Inference Toggle
# Set to 'True' to invoke remote AWS Lambda for rent predictions.
# Set to 'False' to use local in-process XGBoost model.
USE_CLOUD_LAMBDA=False

# AWS Configuration (Used when USE_CLOUD_LAMBDA=True)
AWS_REGION=ap-south-1
LAMBDA_FUNCTION_NAME=search-estate-rent-predictor

# Optional HTTP Endpoint / Function URL (if invoking Lambda via HTTP rather than boto3)
# LAMBDA_ENDPOINT_URL=https://<function-url-id>.lambda-url.ap-south-1.on.aws/
LAMBDA_TIMEOUT_SECONDS=5.0
